# Copy to .env.supabase-local.local after running `npm run supabase:start`.
# Replace the keys with the values printed by Supabase CLI.

NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_local_anon_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_local_service_role_key

NEXTAUTH_URL=http://localhost:4000
NEXTAUTH_SECRET=local-dev-secret-change-me

DEEPSEEK_API_KEY=replace_or_reuse_for_local_testing
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

ENABLE_RAG=false
RAG_API_BASE=http://localhost:8000
ENABLE_SMART_SUMMARY=false

FOLLOWUP_UNSUBSCRIBE_SECRET=local-test-secret
APP_URL=http://localhost:4000
CRON_SECRET=local-cron-secret
