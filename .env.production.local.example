# Copy to .env.production.local only when you intentionally need production.
# Do not use production credentials for local feature testing.

NEXT_PUBLIC_SUPABASE_URL=https://your-production-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_production_anon_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_production_service_role_key

NEXTAUTH_URL=http://localhost:4000
NEXTAUTH_SECRET=replace_with_production_compatible_secret

DEEPSEEK_API_KEY=replace_with_llm_key
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

ENABLE_RAG=true
RAG_API_BASE=replace_with_rag_endpoint
ENABLE_SMART_SUMMARY=true
